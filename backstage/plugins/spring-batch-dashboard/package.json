{
  "name": "@jikwan/backstage-plugin-spring-batch-dashboard",
  "version": "1.0.4",
  "description": "Backstage plugin for monitoring and managing Spring Batch jobs with comprehensive execution tracking, failure analysis, and step-level metrics visualization",
  "main": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "license": "Apache-2.0",
  "homepage": "https://github.com/zc149/backstage-plugin-spring-batch-dashboard#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/zc149/backstage-plugin-spring-batch-dashboard.git",
    "directory": "plugins/spring-batch-dashboard"
  },
  "bugs": {
    "url": "https://github.com/zc149/backstage-plugin-spring-batch-dashboard/issues"
  },
  "keywords": [
    "backstage",
    "backstage-plugin",
    "spring-batch",
    "spring-boot",
    "batch-jobs",
    "monitoring",
    "dashboard",
    "job-execution",
    "metrics"
  ],
  "author": "jikwan",
  "publishConfig": {
    "access": "public"
  },
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "spring-batch-dashboard",
    "bundled": true,
    "pluginPackages": [
      "@jikwan/backstage-plugin-spring-batch-dashboard",
      "@jikwan/backstage-plugin-spring-batch-dashboard-backend"
    ]
  },
  "sideEffects": false,
  "scripts": {
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean"
  },
  "dependencies": {
    "@backstage/core-components": "^0.16.3",
    "@backstage/core-plugin-api": "^1.9.4",
    "@backstage/frontend-plugin-api": "^0.17.3",
    "@mui/icons-material": "^6.1.11",
    "@mui/lab": "^6.0.0-beta.17",
    "@mui/material": "^6.1.11",
    "react": "^18.0.2",
    "react-dom": "^18.0.2",
    "react-use": "^17.2.4",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@backstage/cli": "^0.29.3",
    "@backstage/core-app-api": "^1.16.0",
    "@backstage/dev-utils": "^1.1.9",
    "@backstage/test-utils": "^1.6.3",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@types/node": "^18",
    "@types/react": "^18",
    "react-router-dom": "^6.3.0"
  },
  "peerDependencies": {
    "react": "^18.0.2",
    "react-dom": "^18.0.2",
    "react-router-dom": "^6.3.0"
  },
  "files": [
    "dist"
  ]
}
