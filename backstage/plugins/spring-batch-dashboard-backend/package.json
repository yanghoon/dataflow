{
  "name": "@jikwan/backstage-plugin-spring-batch-dashboard-backend",
  "version": "1.0.4",
  "description": "Backend plugin for Backstage Spring Batch Dashboard - provides REST API for Spring Batch job monitoring with multi-environment database support",
  "main": "dist/index.cjs.js",
  "types": "dist/index.d.ts",
  "license": "Apache-2.0",
  "homepage": "https://github.com/zc149/backstage-plugin-spring-batch-dashboard#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/zc149/backstage-plugin-spring-batch-dashboard.git",
    "directory": "plugins/spring-batch-dashboard-backend"
  },
  "bugs": {
    "url": "https://github.com/zc149/backstage-plugin-spring-batch-dashboard/issues"
  },
  "keywords": [
    "backstage",
    "backstage-plugin",
    "backstage-backend",
    "spring-batch",
    "spring-boot",
    "batch-jobs",
    "monitoring",
    "api",
    "postgresql"
  ],
  "author": "jikwan",
  "publishConfig": {
    "access": "public"
  },
  "backstage": {
    "role": "backend-plugin",
    "pluginId": "spring-batch-dashboard",
    "bundled": true
  },
  "sideEffects": false,
  "scripts": {
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test --passWithNoTests",
    "clean": "backstage-cli package clean"
  },
  "dependencies": {
    "@backstage/backend-plugin-api": "^1.5.0",
    "@backstage/config": "^1.3.6",
    "express": "^4.17.1",
    "knex": "^3.1.0",
    "pg": "^8.11.0"
  },
  "devDependencies": {
    "@backstage/cli": "^0.29.3",
    "@types/express": "^4.17.6",
    "@types/node": "^18",
    "@types/pg": "^8.11.0"
  },
  "files": [
    "dist",
    "database",
    "config.d.ts",
    "app-config.example.yaml"
  ]
}
