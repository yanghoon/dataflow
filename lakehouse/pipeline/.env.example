# 환경 변수 목록. 비밀 값은 적지 않는다.
#   cp pipeline/.env.example pipeline/.env   그다음 pipeline/.env 에서 바꿀 줄만 주석을 푼다(Git 제외)
# 주석으로 둔 값은 기본값이다. 기본값은 pipeline/_init/base.sql(S3는 _init/s3.sql)에 있다.
# .env 에 쓴 값은 명령줄 환경 변수(START_DAY=… pipeline/run.sh …)보다 나중에 읽혀 그 값을 덮는다. 자주 바꾸는 값은 주석으로 둔다.

# 초기화 파일. 공백으로 나눠 쓴 순서대로 읽는다. S3에서는 s3.sql 을 더한다
# INIT_FILES="pipeline/_init/base.sql"
# INIT_FILES="pipeline/_init/base.sql pipeline/_init/s3.sql"

# 위치(작업 폴더 lakehouse/ 기준)
# DATA_ROOT=s3-local                  브론즈·실버·골드의 최상위. S3: s3://local
# SOURCE_ROOT=source                  시험용 원본 폴더
# SOURCE_URL=https://dbt-tutorial-public.s3.us-west-2.amazonaws.com/long_term_dataset   자르기 전 원본(jaffle_shop/_sample/00 만 씀). 로컬 폴더도 된다

# jaffle_shop 시험 기간
# START_DAY=2019-09-12                자를 기간의 첫날
# DAYS=3                              기간 일수
# BRONZE_EVERY_HOURS=3                브론즈 수집 간격(24의 약수). 스냅샷 수 = 24 / 간격 × DAYS

# employees 스냅샷 날짜(원천 데이터는 2002-08-01까지)
# EMP_AS_OF_DAY=2000-01-01

# S3 인증(pipeline/_init/s3.sql). INIT_FILES 에 s3.sql 이 있을 때만 쓴다
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_KEY_ID=
# S3_REGION=us-east-1
# S3_URL_STYLE=path
# S3_USE_SSL=true

# employees 로컬 MySQL(pipeline/employees/_sample/_origin.sql). 비밀번호(EMP_MYSQL_PASSWORD)는 여기 두지 않고 셸에서 만든다(pipeline/employees/_sample/README.md 2장)
# EMP_MYSQL_HOST=127.0.0.1
# EMP_MYSQL_PORT=3306
# EMP_MYSQL_USER=reader
